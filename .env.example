# ===== EDIT THESE =====
# Your sandbox resource group, exactly as it appears in the Azure portal (rg-ais-ncus-<alias>-sandbox).
AZURE_RESOURCE_GROUP=rg-ais-ncus-<alias>-sandbox
# owner/name of YOUR GitHub repo that runs the workflows (only 0b_pipeline_identity uses it).
GITHUB_REPO=<owner>/<repo>

# ===== DEFAULTS (leave as is) =====
# The sandbox subscription. Every student is in this one.
AZURE_SUBSCRIPTION_ID=27027400-9dcc-44a4-9945-2bbb422b4116
AZURE_LOCATION=northcentralus
# Three agents are created in your project: bakery-support-dev, -test and -prod.
AGENT_NAME=bakery-support

# ===== FILLED IN BY scripts/0_prepare (discovered from your resource group) =====
FOUNDRY_ACCOUNT=
FOUNDRY_PROJECT=
